[preset00]
// LVS audio diagnostic: frequency spectrum plus three independent band meters.
// Left=LOW/bass (red), centre=MID (green), right=HIGH/treble (blue).
// The circles are intentionally visible even in silence.
fDecay=0
zoom=1
warp=0
rot=0
wave_a=0
ob_size=0
ib_size=0
bDarkenCenter=0

// Spectrum across lower half of the screen: FFT value1 from projectM.
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_bSpectrum=1
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=0
wavecode_0_scaling=1
wavecode_0_smoothing=0.45
wavecode_0_r=0.35
wavecode_0_g=0.75
wavecode_0_b=1
wavecode_0_a=1
wave_0_per_point1=x=sample;
wave_0_per_point2=y=0.17+min(0.25,abs(value1)*0.12);

// LOW - bass audio-reactive solid circle
shapecode_0_enabled=1
shapecode_0_sides=64
shapecode_0_additive=0
shapecode_0_textured=0
shapecode_0_x=0.23
shapecode_0_y=0.69
shapecode_0_rad=0.045
shapecode_0_r=1
shapecode_0_g=0.2
shapecode_0_b=0.2
shapecode_0_a=0.85
shapecode_0_r2=1
shapecode_0_g2=0.2
shapecode_0_b2=0.2
shapecode_0_a2=0.85
shapecode_0_border_a=1
shape_0_per_frame1=rad=0.045+0.075*min(1,max(0,bass)/2);

// MID audio-reactive solid circle
shapecode_1_enabled=1
shapecode_1_sides=64
shapecode_1_additive=0
shapecode_1_textured=0
shapecode_1_x=0.5
shapecode_1_y=0.69
shapecode_1_rad=0.045
shapecode_1_r=0.2
shapecode_1_g=1
shapecode_1_b=0.35
shapecode_1_a=0.85
shapecode_1_r2=0.2
shapecode_1_g2=1
shapecode_1_b2=0.35
shapecode_1_a2=0.85
shapecode_1_border_a=1
shape_1_per_frame1=rad=0.045+0.075*min(1,max(0,mid)/2);

// HIGH - treble audio-reactive solid circle
shapecode_2_enabled=1
shapecode_2_sides=64
shapecode_2_additive=0
shapecode_2_textured=0
shapecode_2_x=0.77
shapecode_2_y=0.69
shapecode_2_rad=0.045
shapecode_2_r=0.25
shapecode_2_g=0.5
shapecode_2_b=1
shapecode_2_a=0.85
shapecode_2_r2=0.25
shapecode_2_g2=0.5
shapecode_2_b2=1
shapecode_2_a2=0.85
shapecode_2_border_a=1
shape_2_per_frame1=rad=0.045+0.075*min(1,max(0,treb)/2);

